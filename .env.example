# Copiá este archivo a .env.local y completá los valores. Nunca subas .env.local.

# Base de datos (Neon). Sin DATABASE_URL, `npm run dev` usa una base en memoria con datos de ejemplo.
# DATABASE_URL usa el pooler; DATABASE_URL_UNPOOLED es para migraciones.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# URL pública de la app
APP_URL=http://localhost:3000

# Sesiones y autenticación (Auth.js). Generar con: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google Maps (Fase 4): clave de servidor para Routes/Geocoding y clave de navegador para Places
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Cloudflare Turnstile (Fase 4)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Almacenamiento de imágenes de platos, compatible con S3 (Fase 7)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Cron (Vercel Cron envía este secreto en Authorization: Bearer)
CRON_SECRET=
